diff --git a/ckks_fv/rss_checkpoint.go b/ckks_fv/rss_checkpoint.go
new file mode 100644
index 0000000..0c0ed10
--- /dev/null
+++ b/ckks_fv/rss_checkpoint.go
@@ -0,0 +1,91 @@
+package ckks_fv
+
+// RSS checkpoint instrumentation (PPFDaaS patch 0001-rss-checkpoints.patch).
+//
+// checkpointRSS is a no-op unless RSS_CHECKPOINT_RUN=1, so builds that carry
+// this patch but are timing a run are not perturbed (one bool test per call).
+// When enabled it appends one JSON line per call to $RSS_CHECKPOINT_PATH
+// (default /results/rss_checkpoints.jsonl, the container's results mount),
+// flushed immediately so a SIGKILL does not lose prior checkpoints.
+//
+// The same env var and path are honoured by the committed harness
+// tools/transciphering/cipher/rss_checkpoint_test.go; when both are active
+// they append to the same file and the lines interleave. Lines from this
+// file carry no param_state field.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"time"
+)
+
+var rssCheckpointEnabled = os.Getenv("RSS_CHECKPOINT_RUN") == "1"
+
+var rssCheckpointPath = func() string {
+	if p := os.Getenv("RSS_CHECKPOINT_PATH"); p != "" {
+		return p
+	}
+	return "/results/rss_checkpoints.jsonl"
+}()
+
+func readVmHWMKB() int64 {
+	f, err := os.Open("/proc/self/status")
+	if err != nil {
+		return -1
+	}
+	defer f.Close()
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		line := sc.Text()
+		if strings.HasPrefix(line, "VmHWM:") {
+			fields := strings.Fields(line)
+			if len(fields) >= 2 {
+				if v, err := strconv.ParseInt(fields[1], 10, 64); err == nil {
+					return v
+				}
+			}
+		}
+	}
+	return -1
+}
+
+func checkpointRSS(label string) {
+	if !rssCheckpointEnabled {
+		return
+	}
+	var ms runtime.MemStats
+	runtime.ReadMemStats(&ms)
+
+	rec := map[string]interface{}{
+		"source":         "ckks_fv_internal",
+		"label":          label,
+		"timestamp":      time.Now().Format(time.RFC3339Nano),
+		"vm_hwm_kb":      readVmHWMKB(),
+		"heap_alloc_kb":  int64(ms.HeapAlloc / 1024),
+		"total_alloc_kb": int64(ms.TotalAlloc / 1024),
+		"gomemlimit_env": os.Getenv("GOMEMLIMIT"),
+		"gogc_env":       os.Getenv("GOGC"),
+	}
+	b, err := json.Marshal(rec)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "checkpointRSS: marshal error: %v\n", err)
+		return
+	}
+
+	_ = os.MkdirAll(filepath.Dir(rssCheckpointPath), 0755)
+	f, err := os.OpenFile(rssCheckpointPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "checkpointRSS: open error: %v\n", err)
+		return
+	}
+	defer f.Close()
+	f.Write(b)
+	f.Write([]byte("\n"))
+	f.Sync()
+}
