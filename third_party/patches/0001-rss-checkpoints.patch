diff --git a/ckks_fv/fv_hera.go b/ckks_fv/fv_hera.go
index 13eac37..2467bcf 100644
--- a/ckks_fv/fv_hera.go
+++ b/ckks_fv/fv_hera.go
@@ -241,23 +241,35 @@ func (hera *mfvHera) Crypt(nonce [][]byte, kCt []*Ciphertext, heraModDown []int)
 		panic(errorString)
 	}
 
+	checkpointRSS("crypt_entry")
 	for st := 0; st < 16; st++ {
 		hera.mkCt[st] = kCt[st].CopyNew().Ciphertext()
 	}
 	hera.init(nonce)
+	checkpointRSS("init")
 
 	hera.addRoundKey(0, false)
+	checkpointRSS("round_0")
 	for r := 1; r < hera.numRound; r++ {
 		hera.linLayer()
+		checkpointRSS(fmt.Sprintf("round_%d_linlayer", r))
 		hera.cube()
+		checkpointRSS(fmt.Sprintf("round_%d_cube", r))
 		hera.modSwitch(heraModDown[r])
+		checkpointRSS(fmt.Sprintf("round_%d_modswitch", r))
 		hera.addRoundKey(r, false)
+		checkpointRSS(fmt.Sprintf("round_%d", r))
 	}
 	hera.linLayer()
+	checkpointRSS(fmt.Sprintf("round_%d_linlayer", hera.numRound))
 	hera.cube()
+	checkpointRSS(fmt.Sprintf("round_%d_cube", hera.numRound))
 	hera.modSwitch(heraModDown[hera.numRound])
+	checkpointRSS(fmt.Sprintf("round_%d_modswitch", hera.numRound))
 	hera.linLayer()
+	checkpointRSS(fmt.Sprintf("round_%d_finlinlayer", hera.numRound))
 	hera.addRoundKey(hera.numRound, true)
+	checkpointRSS(fmt.Sprintf("round_%d", hera.numRound))
 	return hera.stCt
 }
 
