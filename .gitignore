# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/

# Artifacts (generated, not source)
artifacts/*.bin
artifacts/*.npy
artifacts/*.pkl

# vendor_server/artifacts/ holds symlinks into artifacts/ above; the root-level
# "artifacts/*.bin" rule does NOT cover this nested path (middle slash anchors
# it to the repo root), so secret_key.bin was previously tracked here as a
# symlink. Never track vendor-side key material.
vendor_server/artifacts/*.bin

# Local datasets (do not commit large raw data)
data/creditcard.csv
data/*.zip

# Nested git checkout inside CMake fetched deps
build/_deps/catch2-src/

# Results (generated)
results/

# Env
.env
*.key

# §1.7: dev mTLS certs (generated by scripts/generate_dev_certs.sh)
certs/

# Locally-built third-party dependencies (e.g. OpenFHE source clone, AUDIT.md
# Phase 2). Not vendored -- cloned and built fresh per environment.
# NOTE: "third_party/*" (not "third_party/"), so the negations below can take
# effect -- git does not descend into a directory excluded by the bare form to
# apply per-file re-includes.
third_party/*
# ...except the fetch script and its build notes, which ARE the source of
# truth for reproducing the pinned checkout above (see third_party/BUILD_NOTES.md).
!third_party/fetch_rtf.sh
!third_party/BUILD_NOTES.md

# Stray build outputs not covered above
tools/local_benchmark/precision_probe
