build/
vendor_server/build/
bank_client/build/
tools/openfhe_benchmark/build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
*.a
*.o
*.so
*.bin.d
*.o.d

# Compiled binaries (repo root and subdir)
build/vendor_server/vendor_server_main
build/vendor_server/vendor_server_160
build/vendor_server/benchmark
